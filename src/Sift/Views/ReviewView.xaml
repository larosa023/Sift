<UserControl x:Class="Sift.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,16,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Review"/>
            <TextBlock Style="{StaticResource Dim}" Text="{Binding Subtitle}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"/>
            <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="8" Background="{DynamicResource SurfaceAltBg}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="Open" Command="{Binding OpenRecycleBinCommand}" Margin="0,0,4,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="Empty Recycle Bin…" Command="{Binding EmptyRecycleBinCommand}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding RecycleBinText}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Totals + actions -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,14" Padding="18,14"
                Visibility="{Binding IsEmpty, Converter={StaticResource NotBoolVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="Remove checked from list" Command="{Binding RemoveCheckedCommand}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource GhostButton}" Content="Clear finished" Command="{Binding ClearFinishedCommand}" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="13" Foreground="White"/>
                            <TextBlock Text="{Binding DeleteButtonText}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CheckedSizeText}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Dim}">
                            <Run Text="{Binding CheckedCount, Mode=OneWay}"/><Run Text=" item(s) checked"/>
                        </TextBlock>
                        <TextBlock Text="{Binding ResultText}" Foreground="{DynamicResource SuccessBrush}" FontSize="12.5"
                                   Visibility="{Binding ResultText, Converter={StaticResource NullVis}}"/>
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Dim}"
                                   Visibility="{Binding ProgressText, Converter={StaticResource NullVis}}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <!-- Empty -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}"/>
                <TextBlock Text="Nothing queued for review" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock Style="{StaticResource Dim}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"
                           Text="Add items from Cleanup, or right-click anything in the Overview treemap and choose Add to review."/>
                <TextBlock Text="{Binding ResultText}" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"
                           Visibility="{Binding ResultText, Converter={StaticResource NullVis}}"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="12,12,12,6" Visibility="{Binding IsEmpty, Converter={StaticResource NotBoolVis}}">
                <ListView ItemsSource="{Binding Items}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked}" Margin="6,0,0,0"
                                                  IsEnabled="{Binding IsFinished, Converter={StaticResource NotBool}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Item" Width="380">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel ToolTip="{Binding Path}">
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14"
                                                       Foreground="{DynamicResource TextDimBrush}" Margin="0,0,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="330" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Faint}" MaxWidth="330" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Size" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="From" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Source}" Foreground="{DynamicResource TextDimBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Action" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ActionText}" Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Status" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="210" ToolTip="{Binding StatusText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" Width="28" Height="28" FontSize="12"
                                                    ToolTip="Show in File Explorer"
                                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="28" Height="28" FontSize="11"
                                                    ToolTip="Remove from list"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>

        <!-- Confirmation overlay -->
        <Grid Grid.RowSpan="3" Margin="-24,-16,-24,-18" Background="#88000000"
              Visibility="{Binding IsConfirming, Converter={StaticResource BoolVis}}">
            <Border Style="{StaticResource Card}" Background="{DynamicResource PopupBg}" Width="480" Padding="24,22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Confirm cleanup"/>
                    <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource TextDimBrush}" LineHeight="20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Cancel" Command="{Binding CancelConfirmCommand}" Margin="0,0,10,0" IsCancel="True"/>
                        <Button Style="{StaticResource DangerButton}" Content="{Binding DeleteButtonText}" Command="{Binding ConfirmCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
