<UserControl x:Class="Sift.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <Style x:Key="RowCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="170"/>
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="DisplayMemberPath" Value="Label"/>
            <Setter Property="SelectedValuePath" Value="Value"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ThemeTile" TargetType="RadioButton">
            <Setter Property="Width" Value="152"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Theme"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="11" BorderThickness="2" BorderBrush="Transparent" Padding="4" Background="Transparent">
                            <StackPanel>
                                <Border CornerRadius="7" Height="86" Background="{Binding Preview.PreviewBg}"
                                        BorderBrush="{Binding Preview.PreviewLine}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding Preview.PreviewSidebar}" CornerRadius="6,0,0,6">
                                            <StackPanel Margin="8,10,8,0">
                                                <Border Height="5" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                                                <Border Height="5" CornerRadius="2" Margin="0,6,0,0" Background="{Binding Preview.PreviewDim}"/>
                                                <Border Height="5" CornerRadius="2" Margin="0,6,0,0" Background="{Binding Preview.PreviewDim}"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,10,9,0">
                                            <Border Height="6" Width="54" CornerRadius="3" HorizontalAlignment="Left" Background="{Binding Preview.PreviewText}"/>
                                            <Border Height="40" Margin="0,9,0,0" CornerRadius="5" Background="{Binding Preview.PreviewCard}"
                                                    BorderBrush="{Binding Preview.PreviewLine}" BorderThickness="1">
                                                <StackPanel Margin="7,7,7,0">
                                                    <Border Height="4" Width="44" CornerRadius="2" HorizontalAlignment="Left" Background="{Binding Preview.PreviewDim}"/>
                                                    <Border Height="7" Width="34" Margin="0,8,0,0" CornerRadius="3" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,8,0,0"/>
                                <TextBlock Text="{Binding Blurb}" Style="{StaticResource Faint}" FontSize="11" Margin="4,1,0,2"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,28" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="Settings"/>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Theme"/>
                    <ItemsControl ItemsSource="{Binding Themes}" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource ThemeTile}" IsChecked="{Binding IsSelected}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Accent colour" Margin="0,8,0,0"/>
                    <ItemsControl ItemsSource="{Binding Accents}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <RadioButton Style="{StaticResource Swatch}" GroupName="Accent" Background="{Binding Brush}"
                                                 IsChecked="{Binding IsSelected}" ToolTip="{Binding Name}"/>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE770;" FontSize="11" Foreground="White"
                                               HorizontalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"
                                               Visibility="{Binding IsWindows, Converter={StaticResource BoolVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                               Text="The first swatch follows your Windows accent colour (Settings › Personalization › Colors)."/>
                </StackPanel>
            </Border>

            <!-- Deleting -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Deleting"/>
                    <CheckBox Margin="0,14,0,0" IsChecked="{Binding PermanentDeleteCaches}">
                        <StackPanel>
                            <TextBlock Text="Delete caches and temp files permanently"/>
                            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" TextTrimming="None"
                                       Text="Apps rebuild caches on their own, so sending them to the Recycle Bin just moves the space. Other items still go to the Recycle Bin."/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Margin="0,14,0,0" IsChecked="{Binding PermanentDelete}">
                        <StackPanel>
                            <TextBlock Text="Skip the Recycle Bin for everything"/>
                            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" TextTrimming="None" Foreground="{DynamicResource WarningBrush}"
                                       Text="Deleted items can't be restored. Leave this off unless you're sure."/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Scanning -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding AddExclusionCommand}" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12"/>
                                <TextBlock Text="Add folder…" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Skipped folders"/>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                                       Text="Scans skip these folders entirely — handy for network shares, VM disks or a backup drive you don't want counted. You can also right-click any folder in the treemap."/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Faint}" Text="No folders skipped." Margin="0,12,0,0"
                               Visibility="{Binding HasExclusions, Converter={StaticResource NotBoolVis}}"/>
                    <ItemsControl ItemsSource="{Binding Exclusions}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        CornerRadius="7" Padding="12,6,6,6" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Width="26" Height="26" FontSize="10"
                                                ToolTip="Stop skipping this folder"
                                                Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="13" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Rules -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Cleanup rules"/>
                    <DockPanel Style="{StaticResource Row}">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding DayChoices}" SelectedValue="{Binding GameUnplayedDays}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Unplayed games"/>
                            <TextBlock Style="{StaticResource Dim}" Text="Flag games you haven't launched in at least…"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding DayChoices}" SelectedValue="{Binding StaleDownloadDays}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Stale downloads"/>
                            <TextBlock Style="{StaticResource Dim}" Text="Flag items in Downloads untouched for at least…"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding DayChoices}" SelectedValue="{Binding LeftoverMinAgeDays}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Leftover app folders"/>
                            <TextBlock Style="{StaticResource Dim}" Text="Only flag folders that haven't changed in at least…"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding DuplicateSizeChoices}" SelectedValue="{Binding DuplicateMinBytes}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Duplicate files"/>
                            <TextBlock Style="{StaticResource Dim}" Text="Ignore files smaller than…"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding CacheSizeChoices}" SelectedValue="{Binding CacheMinBytes}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Caches"/>
                            <TextBlock Style="{StaticResource Dim}" Text="Only show caches larger than…"/>
                        </StackPanel>
                    </DockPanel>
                    <CheckBox Margin="0,16,0,0" IsChecked="{Binding DuplicatesSkipSystemFolders}">
                        <StackPanel>
                            <TextBlock Text="Skip system, program and app-data folders when finding duplicates"/>
                            <TextBlock Style="{StaticResource Dim}" Text="Apps and games often ship identical files on purpose. Recommended."/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" DataContext="{Binding Updates}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Updates"/>
                    <DockPanel Margin="0,14,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Install update" Style="{StaticResource AccentButton}" Command="{Binding InstallCommand}" Margin="0,0,8,0"/>
                            <Button Content="Check now" Command="{Binding CheckCommand}"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentVersion, StringFormat='Sift {0}'}"/>
                            <TextBlock Style="{StaticResource Dim}" Text="{Binding StatusText}" TextWrapping="Wrap" TextTrimming="None"/>
                        </StackPanel>
                    </DockPanel>
                    <CheckBox Margin="0,14,0,0"
                              IsChecked="{Binding DataContext.AutoCheckUpdates, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <StackPanel>
                            <TextBlock Text="Check for updates when Sift starts"/>
                            <TextBlock Style="{StaticResource Dim}" Text="Updates come from GitHub Releases and are verified before installing."/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Shortcuts -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Keyboard shortcuts"/>
                    <ItemsControl ItemsSource="{Binding Shortcuts}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <Border DockPanel.Dock="Left" Width="190" HorizontalAlignment="Left">
                                        <Border HorizontalAlignment="Left" Background="{DynamicResource SurfaceAltBg}" BorderBrush="{DynamicResource LineStrongBrush}"
                                                BorderThickness="1,1,1,2" CornerRadius="5" Padding="7,2">
                                            <TextBlock Text="{Binding Keys}" FontSize="12" FontFamily="Cascadia Mono, Consolas"/>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="{Binding Action}" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="About"/>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                               Text="Sift is a fast disk space analyzer and cleanup tool for Windows. Nothing is deleted without your confirmation."/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource LinkButton}" Content="{Binding RepoUrl}" Command="{Binding OpenRepoCommand}"/>
                        <Button Style="{StaticResource LinkButton}" Content="Open settings folder" Command="{Binding OpenDataFolderCommand}" Margin="20,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
