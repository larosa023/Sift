<UserControl x:Class="Sift.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,16,24,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Left: checks ===== -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock Style="{StaticResource H1}" Text="Cleanup"/>
                <TextBlock Style="{StaticResource Dim}" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch" Command="{Binding RunAllCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="12" Foreground="{DynamicResource AccentTextBrush}"/>
                        <TextBlock Text="Run all checks" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <ListBox ItemsSource="{Binding Finders}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource CardListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" HorizontalAlignment="Center" FontSize="15"
                                           Foreground="{DynamicResource AccentForegroundBrush}"/>
                            </Border>
                            <Grid DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Control Style="{StaticResource Spinner}" Width="16" Height="16"
                                         Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"/>
                            </Grid>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ===== Right: selected check ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" DataContext="{Binding Selected}" Padding="20,18,20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Command="{Binding CancelCommand}" Content="Stop" Margin="0,0,8,0"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"/>
                            <Button Command="{Binding RunCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="13"/>
                                    <TextBlock Text="Check again" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource H2}" FontSize="19" Text="{Binding Title}"/>
                                <TextBlock Text="{Binding BigNumber}" FontSize="19" FontFamily="{StaticResource DisplayFont}" Margin="12,0,0,0"
                                           Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Dim}" Text="{Binding Description}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,24,0" MaxWidth="720" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Selection toolbar -->
                    <DockPanel Margin="0,16,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Style="{StaticResource AccentButton}"
                                    Command="{Binding DataContext.AddToReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12" Foreground="{DynamicResource AccentTextBrush}"/>
                                    <TextBlock Text="Add to review" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Content="Select suggested"
                                    Command="{Binding DataContext.SelectSuggestedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Style="{StaticResource GhostButton}" Content="Select all"
                                    Command="{Binding DataContext.SelectAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Style="{StaticResource GhostButton}" Content="Clear"
                                    Command="{Binding DataContext.SelectNoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <Grid>
                    <!-- Running -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}">
                        <Control Style="{StaticResource Spinner}" Width="26" Height="26"/>
                        <TextBlock Text="{Binding Progress}" Style="{StaticResource Dim}" Margin="0,12,0,0" HorizontalAlignment="Center" MaxWidth="520"/>
                    </StackPanel>

                    <!-- Not run yet -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowIntro, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="34" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFaintBrush}"/>
                        <TextBlock Text="This check hasn't run yet." Style="{StaticResource Dim}" Margin="0,12,0,12" HorizontalAlignment="Center"/>
                        <Button Content="Run this check" Command="{Binding RunCommand}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Nothing found -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowEmpty, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="34" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="All clear — nothing to clean up here." Style="{StaticResource Dim}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Error -->
                    <Border VerticalAlignment="Top" Padding="14,10" CornerRadius="8" Background="{DynamicResource WarningSoftBrush}"
                            Visibility="{Binding Error, Converter={StaticResource NullVis}}">
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                    </Border>

                    <!-- Results -->
                    <ListView ItemsSource="{Binding View}" Visibility="{Binding Count, Converter={StaticResource CountVis}}">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" FontSize="11.5" Margin="8,14,0,4"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Show in File Explorer"
                                                      Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Add to review"
                                                      Command="{Binding PlacementTarget.Tag.AddOneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="6,0,0,0"
                                                      IsEnabled="{Binding IsQueued, Converter={StaticResource NotBool}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Item" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding Path}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                                                    <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Visibility="{Binding IsQueued, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="In review" FontSize="10.5" Foreground="{DynamicResource AccentForegroundBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Faint}" MaxWidth="290" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Size" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Last used" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding LastUsedText}"/>
                                                <TextBlock Text="{Binding LastUsedLabel}" Style="{StaticResource Faint}" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Notes" Width="230">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border CornerRadius="9" Padding="7,1" VerticalAlignment="Center"
                                                        Background="{Binding Risk, Converter={StaticResource RiskSoftBrush}}">
                                                    <TextBlock Text="{Binding RiskText}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" Margin="8,0,0,0" MaxWidth="160" ToolTip="{Binding Detail}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
