<UserControl x:Class="Sift.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sift.Controls">
    <UserControl.Resources>
        <ContextMenu x:Key="NodeMenu" x:Shared="False">
            <MenuItem Header="Zoom into folder" Command="{Binding NavigateCommand}" CommandParameter="{Binding Selected}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE71E;"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Open" Command="{Binding OpenCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE8E5;"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Show in File Explorer" Command="{Binding OpenInExplorerCommand}" InputGestureText="Ctrl+E">
                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE838;"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE8C8;"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Add to review" Command="{Binding AddToReviewCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE74D;"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Skip this folder in future scans" Command="{Binding ExcludeCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE8D8;"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <!-- ============ Start: pick a drive ============ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowStart, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="40,30,40,30" MaxWidth="1000" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource H1}" Text="What's taking up space?"/>
                <TextBlock Style="{StaticResource Dim}" FontSize="13.5" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Pick a drive to map every file and folder. Nothing on your PC changes until you review and confirm."/>
                <Border Margin="0,16,0,0" Padding="12,8" CornerRadius="7" Background="{DynamicResource DangerSoftBrush}"
                        Visibility="{Binding Error, Converter={StaticResource NullVis}}">
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
                </Border>

                <Border Margin="0,16,0,0" Padding="12,9" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}"
                        HorizontalAlignment="Left" Visibility="{Binding ShowFastScanTip, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="13" Foreground="{DynamicResource AccentForegroundBrush}"/>
                        <TextBlock Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="760">
                            <Run Text="Fast scan:" FontWeight="SemiBold"/>
                            <Run Text="run Sift as administrator (button at the top) and it reads the drive's file table directly — whole drives in seconds."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Drives}" Margin="0,26,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="300" Margin="0,0,14,14" Padding="0" Cursor="Hand"
                                    Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Root}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource LineBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="18,16">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xEDA2;" FontSize="18" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource AccentForegroundBrush}"/>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding UsageText}" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Margin="0,16,0,0" Height="6">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding LastScanText}" Style="{StaticResource Faint}"/>
                                        <TextBlock Style="{StaticResource Faint}">
                                            <Run Text="Scan"/><Run Text=" "/><Run Text="{Binding Letter, Mode=OneWay}"/><Run Text="  →"/>
                                        </TextBlock>
                                    </DockPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Command="{Binding BrowseCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="14"/>
                            <TextBlock Text="Scan a folder…" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding NewScanCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="13"/>
                            <TextBlock Text="Refresh drives" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Margin="0,30,0,0" Visibility="{Binding HasRecents, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="RECENT FOLDERS" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Recents}" MaxWidth="640" HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="28" Height="28" Margin="0,0,6,0"
                                                ToolTip="Remove from recents"
                                                Command="{Binding DataContext.RemoveRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="12,8"
                                                Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Path}" IsEnabled="{Binding Exists}" ToolTip="Scan this folder again">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" FontSize="14" Foreground="{DynamicResource AccentForegroundBrush}"/>
                                                <StackPanel Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Faint}" MaxWidth="520" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock Style="{StaticResource Faint}" Margin="0,24,0,0" Text="Tip: drag a folder or drive onto this window to scan it."/>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Opening the saved scan ============ -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsRestoring, Converter={StaticResource BoolVis}}">
            <Control Style="{StaticResource Spinner}" Width="26" Height="26"/>
            <TextBlock Text="Opening your last scan…" Style="{StaticResource Dim}" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- ============ Scanning ============ -->
        <Grid Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}">
            <Border Style="{StaticResource Card}" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,26">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Control Style="{StaticResource Spinner}" Width="22" Height="22"/>
                        <TextBlock Style="{StaticResource H2}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"
                                   Text="{Binding ScanTarget, StringFormat='Scanning {0}'}"/>
                        <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Visibility="{Binding IsFastScanning, Converter={StaticResource BoolVis}}"
                                ToolTip="Reading the drive's file table directly">
                            <TextBlock Text="Fast scan" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentForegroundBrush}"/>
                        </Border>
                    </StackPanel>
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Margin="0,22,0,0"/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ProgressBytes}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ProgressFiles}" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ProgressTime}" Style="{StaticResource Dim}" VerticalAlignment="Bottom"/>
                    </Grid>
                    <TextBlock Text="{Binding ProgressPath}" Style="{StaticResource Faint}" Margin="0,14,0,0"/>
                    <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Right" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ Results ============ -->
        <Grid Visibility="{Binding ShowResults, Converter={StaticResource BoolVis}}" Margin="20,10,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding RescanCommand}" Margin="0,0,8,0" ToolTip="Scan the same location again">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="13"/>
                            <TextBlock Text="Rescan" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NewScanCommand}" Style="{StaticResource GhostButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xEDA2;" FontSize="13"/>
                            <TextBlock Text="Other drive" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE74A;" Command="{Binding UpCommand}" ToolTip="Up one level (Backspace)" Margin="0,0,6,0"/>
                <ItemsControl ItemsSource="{Binding Breadcrumb}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Chevron" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="10" Margin="6,0"
                                           Foreground="{DynamicResource TextFaintBrush}"/>
                                <Button Style="{StaticResource GhostButton}" Padding="6,4" MaxWidth="220"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Node}" ToolTip="{Binding Node.FullPath}">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                    <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="4,6,0,10">
                <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource Faint}"/>
                <Border Margin="-4,8,0,0" Padding="12,7" CornerRadius="8" Background="{DynamicResource WarningSoftBrush}" HorizontalAlignment="Left"
                        Visibility="{Binding IsFromCache, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" FontSize="13" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="{Binding CacheText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource LinkButton}" Content="Rescan now" Margin="12,0,0,0" Command="{Binding RescanCommand}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition x:Name="ListColumn" Width="440" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- Treemap + legend -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="{Binding HoverText}" Style="{StaticResource Dim}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasHighlight, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding HighlightText}" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource LinkButton}" Content="Clear" Margin="10,0,0,0" FontSize="12" Command="{Binding ClearHighlightCommand}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="COLOUR BY" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="ColorMode" Content="File type" Padding="10,3"
                                         IsChecked="{Binding ColorMode, Converter={StaticResource Equals}, ConverterParameter=Type}"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="ColorMode" Content="Last modified" Padding="10,3"
                                         IsChecked="{Binding ColorMode, Converter={StaticResource Equals}, ConverterParameter=Age}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Categories}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="Chip" Style="{StaticResource GhostButton}" Padding="7,3" Margin="0,0,4,2" ToolTip="{Binding Tip}"
                                            Command="{Binding DataContext.HighlightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" Margin="6,0,0,0" FontSize="12"/>
                                            <TextBlock Text="{Binding SizeText}" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource TextFaintBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                            <Setter TargetName="Chip" Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="1"
                            Background="{DynamicResource TreemapBgBrush}">
                        <controls:TreemapControl x:Name="Treemap"
                                                 Root="{Binding Current}"
                                                 Selected="{Binding Selected}"
                                                 Hovered="{Binding Hovered, Mode=OneWayToSource}"
                                                 LayoutVersion="{Binding LayoutVersion}"
                                                 Highlight="{Binding Highlight}"
                                                 ColorMode="{Binding ColorMode}"
                                                 ContextMenu="{StaticResource NodeMenu}"/>
                    </Border>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"
                              DragCompleted="Splitter_DragCompleted"/>

                <!-- Folder contents -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,14,12,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="6,0,6,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE78C;" Width="30" Height="30" FontSize="13"
                                        ToolTip="Export this list to CSV" Command="{Binding ExportCommand}"/>
                                <TextBlock Text="{Binding ListTitle}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding CurrentSummary}" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <RadioButton Style="{StaticResource Chip}" GroupName="ListMode" Content="Contents"
                                             IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Contents}"/>
                                <RadioButton Style="{StaticResource Chip}" GroupName="ListMode" Content="Largest files"
                                             IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=LargestFiles}"/>
                                <RadioButton Style="{StaticResource Chip}" GroupName="ListMode" Content="Types"
                                             ToolTip="Space used by each file extension"
                                             IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Types}"/>
                                <RadioButton Style="{StaticResource Chip}" GroupName="ListMode" Content="Changes"
                                             ToolTip="{Binding CompareText}"
                                             Visibility="{Binding HasCompare, Converter={StaticResource BoolVis}}"
                                             IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Changes}"/>
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Faint}" Visibility="{Binding IsChangesMode, Converter={StaticResource BoolVis}}">
                                <Run Text="Compared with your scan from"/> <Run Text="{Binding CompareText, Mode=OneWay}"/>
                            </TextBlock>
                            <Grid Margin="0,10,0,0">
                                <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,28,6"/>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" FontSize="12" Margin="11,0,0,0" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TextFaintBrush}" IsHitTestVisible="False"/>
                                <TextBlock Text="Filter by name or *.ext   (Ctrl+F)" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextFaintBrush}"
                                           Visibility="{Binding FilterText, Converter={StaticResource NotNullVis}}"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="24" Height="24" FontSize="9" HorizontalAlignment="Right" Margin="0,0,4,0"
                                        ToolTip="Clear filter" Click="ClearFilter_Click"
                                        Visibility="{Binding FilterText, Converter={StaticResource NullVis}}"/>
                            </Grid>
                            <CheckBox Margin="0,8,0,0" IsChecked="{Binding SearchSubfolders}" FontSize="12"
                                      ToolTip="Search every folder below this one, not just this folder. Wildcards work too: *.mp4, IMG_20??*">
                                <TextBlock Text="Search subfolders too" FontSize="12" Foreground="{DynamicResource TextDimBrush}"/>
                            </CheckBox>
                        </StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding RowsEmptyText}" Style="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,30,0,0"
                                       Visibility="{Binding ShowRowsEmpty, Converter={StaticResource BoolVis}}"/>
                            <ListView x:Name="ContentsList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                                      ContextMenu="{StaticResource NodeMenu}" MouseDoubleClick="ContentsList_MouseDoubleClick"
                                      GridViewColumnHeader.Click="Header_Click">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="158">
                                            <GridViewColumn.Header>
                                                <TextBlock Text="{Binding NameHeader}" Tag="Name"/>
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <DockPanel ToolTip="{Binding Tip}">
                                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="13" Foreground="{Binding Accent}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                        <StackPanel Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="124" HorizontalAlignment="Left"/>
                                                            <TextBlock Text="{Binding Location}" Style="{StaticResource Faint}" FontSize="11" MaxWidth="124" HorizontalAlignment="Left"
                                                                       Visibility="{Binding HasLocation, Converter={StaticResource BoolVis}}"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="82">
                                            <GridViewColumn.Header>
                                                <TextBlock Text="{Binding SizeHeader}" Tag="Size"/>
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold"/>
                                                        <TextBlock x:Name="DeltaText" Text="{Binding DeltaText}" FontSize="11" Foreground="{DynamicResource WarningBrush}"
                                                                   Visibility="{Binding HasDelta, Converter={StaticResource BoolVis}}"/>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding DeltaSign}" Value="-1">
                                                            <Setter TargetName="DeltaText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Share" Width="74">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding PercentText}" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="4" Width="60"
                                                                     HorizontalAlignment="Left" Margin="0,3,0,0" Foreground="{Binding Accent}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="88">
                                            <GridViewColumn.Header>
                                                <TextBlock Text="{Binding ModifiedHeader}" Tag="Modified"/>
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource TextDimBrush}" FontSize="12"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
